    # =============================================================================
# ICAN Platform Frontend Configuration
# Copy this file to .env for local development
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for backend API (no trailing slash)
VITE_API_URL=http://localhost:8000

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Enable API request/response logging in console
VITE_API_DEBUG=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Token refresh interval (minutes) - how often to check token expiry
VITE_TOKEN_REFRESH_INTERVAL=5

# Session timeout warning (minutes) - warn user before auto-logout
VITE_SESSION_TIMEOUT_WARNING=5

# -----------------------------------------------------------------------------
# Paystack Payment Configuration
# -----------------------------------------------------------------------------
# Paystack public key for payment processing
# Test key (starts with pk_test_) or Live key (starts with pk_live_)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment success redirect URL (relative to app root)
VITE_PAYMENT_SUCCESS_URL=/payment/success

# Payment failure redirect URL (relative to app root)
VITE_PAYMENT_FAILURE_URL=/payment/failure

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable major features (true/false)
VITE_ENABLE_REPORTS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ATTENDANCE=true
VITE_ENABLE_MESSAGING=false
VITE_ENABLE_DOCUMENT_UPLOAD=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Application name (displayed in header, page titles, etc.)
VITE_APP_NAME=ICAN Tutorial Centre

# Application version (displayed in footer, about page)
VITE_APP_VERSION=1.0.0

# Application environment (development, staging, production)
VITE_APP_ENV=development

# Default locale/language
VITE_DEFAULT_LOCALE=en-NG

# Currency code (ISO 4217)
VITE_CURRENCY_CODE=NGN

# Currency symbol
VITE_CURRENCY_SYMBOL=₦

# Date format (for date-fns)
VITE_DATE_FORMAT=dd/MM/yyyy

# Time zone
VITE_TIME_ZONE=Africa/Lagos

# -----------------------------------------------------------------------------
# Developer Experience
# -----------------------------------------------------------------------------
# Enable Mock Service Worker (MSW) for API mocking during development
# Set to 'true' to use mock data instead of real backend
VITE_ENABLE_MSW=false

# Enable React Query Devtools in development
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Maximum file upload size (bytes) - 10MB default
VITE_MAX_FILE_SIZE=10485760

# Allowed file extensions for uploads (comma-separated)
VITE_ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.doc,.docx

# -----------------------------------------------------------------------------
# UI/UX Settings
# -----------------------------------------------------------------------------
# Items per page for paginated lists
VITE_DEFAULT_PAGE_SIZE=20

# Toast notification duration (milliseconds)
VITE_TOAST_DURATION=4000

# Debounce delay for search inputs (milliseconds)
VITE_SEARCH_DEBOUNCE=300

# Auto-save interval for forms (milliseconds) - 0 to disable
VITE_AUTO_SAVE_INTERVAL=0

# Enable animations
VITE_ENABLE_ANIMATIONS=true

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Google Analytics Tracking ID
# VITE_GA_TRACKING_ID=

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=

# LogRocket App ID
# VITE_LOGROCKET_APP_ID=

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# WhatsApp Business API (if enabled)
# VITE_WHATSAPP_PHONE_NUMBER=

# Support email
VITE_SUPPORT_EMAIL=support@icantutorial.com

# Support phone
VITE_SUPPORT_PHONE=+234-XXX-XXX-XXXX

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - All variables must start with VITE_ to be exposed to the client
# - Boolean values should be 'true' or 'false' (lowercase)
# - URLs should not have trailing slashes
# - Sensitive keys (Paystack, Analytics) should never be committed to git
# - Use .env.local for local overrides (git-ignored by default)
# =============================================================================
