# ICAN Tutorial Centre Environment Variables
# DO NOT commit real values. Copy to .env and replace placeholders.
# Rotate ALL keys when moving to production, especially those documented as placeholders below.

# DEBUG MUST BE False in production.
DEBUG=False

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-generated-50-char-django-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/ican_platform
TIME_ZONE=Africa/Lagos

# LiveKit Real-Time Virtual Classroom Integration
# Replace the placeholders below with keys from your LiveKit dashboard.
# The previous example values (starting with APIcAg...) were placeholder-only and MUST NOT be reused.
LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key-placeholder
LIVEKIT_API_SECRET=your-livekit-api-secret-placeholder

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_replace-with-your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-paystack-secret-key
# Set to the webhook signing secret from Paystack dashboard (Settings / Webhooks).
PAYSTACK_WEBHOOK_SECRET=replace-with-your-paystack-webhook-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PREFIX=ican

# Sentry APM & Error Tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

