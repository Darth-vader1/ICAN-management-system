# CI/CD Environment Variables (Dummy Values)
# This file is safe to commit to version control.
# Used strictly by GitHub Actions for testing.

DEBUG=True
SECRET_KEY=ci-dummy-key-do-not-use-in-production
DATABASE_URL=sqlite:///:memory:

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_dummy_public_key
PAYSTACK_SECRET_KEY=sk_test_dummy_secret_key
PAYSTACK_WEBHOOK_SECRET=wh_dummy_webhook_secret

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_PROVIDER=console

# Cloudinary
CLOUDINARY_CLOUD_NAME=dummy_cloud
CLOUDINARY_API_KEY=dummy_key
CLOUDINARY_API_SECRET=dummy_secret
